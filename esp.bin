local b64d = assert(loadstring("local A = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_-\"\
local C = {}\
for i = 0, 63 do C[A:sub(i + 1, i + 1)] = i end\
return function(s)\
    local out, buf, bits = {}, 0, 0\
    for i = 1, #s do\
        local v = C[s:sub(i, i)]\
        if v == nil then return nil, \"b64\" end\
        buf = buf * 64 + v\
        bits = bits + 6\
        if bits >= 8 then\
            bits = bits - 8\
            local p = 2 ^ bits\
            out[#out + 1] = string.char(math.floor(buf / p) % 256)\
            buf = buf % p\
        end\
    end\
    return table.concat(out)\
end\
"))()
